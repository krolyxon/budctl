# Packages the release builds (x86_64 and aarch64) from GitHub. Not on the AUR: build it here with
#   makepkg -si
# For a new release, bump pkgver, reset pkgrel to 1, and take the sums from the release's
# .sha256 files (or run updpkgsums).

pkgname=budctl-bin
pkgver=0.1.3
pkgrel=1
pkgdesc='Control wireless earbuds from Linux without the vendor app (CLI and Wayland GUI)'
arch=('x86_64' 'aarch64')
url='https://github.com/krolyxon/budctl'
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=('glibc' 'gcc-libs' 'bluez')
optdepends=('wayland: for budctl-gui'
            'libxkbcommon: for budctl-gui'
            'fontconfig: system fonts for characters the built-in ones lack')
provides=('budctl')
conflicts=('budctl')
options=('!strip' '!debug')
source_x86_64=("budctl-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/budctl-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("budctl-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/budctl-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('19766c16cec4206eed1b01620048e35d099d003a9bae03abd49aa5773ea1c897')
sha256sums_aarch64=('63319c112866f8d1b9068b0e8091ea90ffca608e0783a3d18b86180b84e4d08d')

package() {
  cd "budctl-$CARCH-unknown-linux-gnu"
  install -Dm755 budctl budctl-gui -t "$pkgdir/usr/bin/"
  install -Dm644 budctl.desktop -t "$pkgdir/usr/share/applications/"
  # The icon ships in the releases after 0.1.3; before, the launcher entry names a stock one.
  if [ -f budctl.svg ]; then
    install -Dm644 budctl.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/budctl.svg"
  fi
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/budctl/"
  install -Dm644 OFL-fonts.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
